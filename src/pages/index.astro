---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/landing/Hero.astro";
import WhatYouCanBuild from "../components/landing/WhatYouCanBuild.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import Faq from "../components/landing/Faq.astro";
import Footer from "../components/landing/Footer.astro";
import { buildLandingJsonLd } from "../data/landing";

// Escape "<" so the JSON can never close the surrounding <script> tag.
const jsonLd = JSON.stringify(buildLandingJsonLd()).replace(/</g, "\\u003c");
---

<Layout>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href="/index.md" title="Genkit overview (Markdown)" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Genkit documentation index for LLMs" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </Fragment>
  <nav class="sticky top-0 z-40 h-16 px-4 sm:px-6 bg-genkit-nav backdrop-blur-md border-b border-border-muted" aria-label="Main">
    <Header />
  </nav>
  <main class="max-w-none m-0">
    <Hero />
    <WhatYouCanBuild />
    <HowItWorks />
    <Faq />
  </main>
  <Footer />
</Layout>

<script>
  import "../scripts/landing-demos";
</script>
