---
// Layout component for the landing page
import "../styles/landing.css";
import GA from "../content/custom/ga.astro";
import Fonts from "../components/Fonts.astro";
import DocsLanguageClient from "../components/DocsLanguageClient.astro";
import { SITE_URL, meta } from "../data/landing";

interface Props {
  title?: string;
  description?: string;
  /** Path of the canonical URL, relative to the site root. */
  canonicalPath?: string;
}

const {
  title = meta.title,
  description = meta.description,
  canonicalPath = "/",
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE_URL).href;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#090b10" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Genkit" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={meta.ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={meta.ogImageAlt} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@GenkitFramework" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={meta.ogImage} />
  <meta name="twitter:image:alt" content={meta.ogImageAlt} />

  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="sitemap" href="/sitemap-index.xml" />
  <slot name="head" />
  <Fonts />
  <script is:inline>
    (() => {
      // Lets CSS tell "JS will animate this" apart from "no JS, show everything".
      document.documentElement.classList.add('js');
      try {
        const stored = localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      } catch {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <DocsLanguageClient />
</head>

<body class="bg-landing bg-landing-gradient text-foreground font-sans min-h-screen m-0 p-0 selection:bg-genkit-primary/20 selection:text-genkit-primary">
  <slot />
  <GA bannerForceDarkMode={true} />
</body>
</html>
