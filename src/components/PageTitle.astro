---
import CopyMarkdownButton from './CopyMarkdownButton.astro';
import AuthorProfileCard from './blog/AuthorProfileCard.astro';
import BlogListingHeader from './blog/BlogListingHeader.astro';
import BlogPostHeader from './blog/BlogPostHeader.astro';

const routeId = (Astro.locals.starlightRoute?.id || '').replace(/\/$/, '');
const isAuthorPage = routeId.startsWith('blog/authors/');
const authorSlug = isAuthorPage ? routeId.replace('blog/authors/', '').toLowerCase() : null;

// Blog listing pages: the index (`blog`), its pagination (`blog/2`, ...) and tag pages.
const isBlogIndex = routeId === 'blog' || /^blog\/\d+$/.test(routeId);
const tagMatch = routeId.match(/^blog\/tags\/(.+)$/);
const activeTag = tagMatch ? tagMatch[1] : null;
const isBlogListing = isBlogIndex || Boolean(activeTag);

// Any other page under `blog/` with a publish date is a blog post.
const entry = Astro.locals.starlightRoute?.entry;
const isBlogPost =
  !isBlogListing && !isAuthorPage && routeId.startsWith('blog/') && Boolean(entry?.data?.date);
---

{isBlogListing && <BlogListingHeader activeTag={activeTag} />}

{isBlogPost && <BlogPostHeader />}

{
  authorSlug && (
    <div class="blog-header blog-header--listing blog-header--author">
      <nav class="blog-breadcrumbs" aria-label="Breadcrumb">
        <a href="/blog/">Blog</a>
      </nav>
      <AuthorProfileCard authorSlug={authorSlug} />
    </div>
  )
}

{
  !isBlogListing && !isBlogPost && !isAuthorPage && (
    <div class="doc-page-title">
      <h1 id="_top">{entry?.data?.title || ''}</h1>
      <CopyMarkdownButton class="title-copy-button" />
    </div>
  )
}

<style>
  @layer starlight.core {
    .doc-page-title {
      margin-top: 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .doc-page-title h1 {
      margin: 0;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    @media (max-width: 50rem) {
      .doc-page-title {
        align-items: flex-start;
      }
    }
  }
</style>
