---
/**
 * Drop-in replacement for starlight-blog's internal `Author.astro` (swapped in
 * by the `blogAuthorOverride` Vite plugin in astro.config.mjs). It renders the
 * same markup as the original, but falls back to an initials avatar — matching
 * the blog post byline — when an author has no picture.
 */
import type { StarlightBlogAuthor } from 'starlight-blog/schema';
import { authorInitials } from './initials';

interface Props {
  author: StarlightBlogAuthor;
}

const { author } = Astro.props;

const isLink = author.url !== undefined;
const Element = isLink ? 'a' : 'div';

// Our authors (src/data/authors.json) use public paths or absolute URLs.
const picture = typeof author.picture === 'string' ? author.picture : undefined;
const pictureSrc =
  picture === undefined || picture.startsWith('http')
    ? picture
    : `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${picture.replace(/^\//, '')}`;
---

<Element href={isLink ? author.url : undefined} class="author">
  {
    pictureSrc ? (
      <img alt={author.name} loading="eager" src={pictureSrc} height="40" width="40" />
    ) : (
      <span class="blog-avatar blog-avatar--initials author-initials" aria-hidden="true">
        {authorInitials(author.name)}
      </span>
    )
  }
  <div class="text">
    <div class="name">{author.name}</div>
    {author.title && <div class="title">{author.title}</div>}
  </div>
</Element>

<style>
  /* Mirrors starlight-blog's Author.astro styles, mapped to Genkit Design System tokens. */
  .author {
    align-items: center;
    display: flex;
    gap: 0.5rem;
    line-height: var(--sl-line-height-headings);
    text-decoration: none;
  }

  .text {
    display: flex;
    flex-direction: column;
  }

  .name {
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--gk-text-primary);
    transition: color 0.15s ease;
  }

  .author[href] .name {
    color: var(--color-genkit-primary);
  }

  .title {
    font-size: var(--sl-text-xs);
    color: var(--gk-text-secondary);
  }

  .author[href]:hover .name {
    color: var(--gk-text-primary);
  }

  img,
  .author-initials {
    border: 1px solid var(--gk-border-default);
    border-radius: 9999px;
    height: 2.5rem;
    width: 2.5rem;
  }
</style>
