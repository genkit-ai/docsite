---
import Icon from '../landing/Icon.astro';
import authorsData from '../../data/authors.json';

interface Props {
  authorSlug: string;
}

const { authorSlug } = Astro.props;
const authorInfo = (authorsData as any)[authorSlug.replace(/\/$/, '').toLowerCase()] || null;

if (!authorInfo) return null;
---

<div class="author-social-banner not-content">
  {authorInfo.image ? (
    <img src={authorInfo.image} alt={authorInfo.name || ''} class="author-avatar-img" />
  ) : (
    <div class="author-avatar-circle">
      <span>{authorInfo.name ? authorInfo.name.split(' ').filter(Boolean).map((n: string) => n[0]).join('') : ''}</span>
    </div>
  )}
  <div class="author-info-col">
    <h1 class="author-banner-name">{authorInfo.name || ''}</h1>
    {authorInfo.title && <div class="author-banner-title">{authorInfo.title}</div>}
    {authorInfo.socials && typeof authorInfo.socials === 'object' && Object.keys(authorInfo.socials).length > 0 && (
      <div class="socials-row">
        {Object.entries(authorInfo.socials).map(([net, url]) => (
          <a href={url as string} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label={net}>
            <Icon name={net as any} size="sm" />
          </a>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .author-social-banner {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding: 1.5rem 1.75rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    border-radius: 16px;
    background: var(--gk-surface-1);
    border: 1px solid var(--gk-border-subtle);
    box-shadow: var(--gk-shadow-card);
  }

  @media (max-width: 40rem) {
    .author-social-banner {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
      padding: 1.5rem;
    }
  }

  .author-avatar-img {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--gk-border-default);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .author-avatar-circle {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--color-genkit-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-landing);
    font-size: 2rem;
    font-weight: 700;
    font-family: var(--font-display);
    flex-shrink: 0;
  }

  .author-info-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  @media (max-width: 40rem) {
    .author-info-col {
      align-items: center;
    }
  }

  .author-banner-name {
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    font-family: var(--font-display);
    color: var(--gk-text-primary);
    margin: 0;
    line-height: 1.15;
  }

  .author-banner-title {
    font-size: 0.9375rem;
    color: var(--gk-text-secondary);
  }

  .socials-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  .social-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 10px;
    background: var(--gk-surface-2);
    border: 1px solid var(--gk-border-subtle);
    color: var(--gk-text-secondary);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none !important;
  }

  .social-icon-btn:hover {
    color: var(--gk-text-primary);
    border-color: var(--gk-accent-border);
    background: var(--gk-accent-subtle);
    transform: translateY(-2px);
  }
</style>
