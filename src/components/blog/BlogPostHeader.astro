---
/**
 * Header for an individual blog post: breadcrumbs, title, subtitle
 * (the post description) and a single-line byline with author avatars,
 * publish date, reading time, and the "Copy as Markdown" action.
 */
import CopyMarkdownButton from '../CopyMarkdownButton.astro';
import authorsData from '../../data/authors.json';

type AuthorInfo = { name: string; title?: string; slug?: string; image?: string };

const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const data = (entry?.data ?? {}) as Record<string, any>;

const title: string = data.title ?? '';
const description: string | undefined =
  typeof data.description === 'string' ? data.description : undefined;
const date: Date | undefined = data.date ? new Date(data.date) : undefined;

const authorsByKey = authorsData as Record<string, AuthorInfo>;
const slugify = (name: string) =>
  name
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-');

const rawAuthors: unknown[] = data.authors
  ? Array.isArray(data.authors)
    ? data.authors
    : [data.authors]
  : [];
const authors: AuthorInfo[] = rawAuthors
  .map((raw) => {
    if (typeof raw === 'string') {
      const info = authorsByKey[raw.toLowerCase()];
      return info ? { ...info, slug: info.slug ?? raw } : { name: raw, slug: slugify(raw) };
    }
    if (raw && typeof raw === 'object' && 'name' in raw) {
      const { name, title, picture } = raw as { name: string; title?: string; picture?: string };
      return { name, title, image: picture, slug: slugify(name) };
    }
    return null;
  })
  .filter((a): a is AuthorInfo => Boolean(a));

const post = Astro.locals.starlightBlog?.posts?.find((p) => p.entry.id === entry?.id);
const readingMinutes = post?.metrics?.readingTime?.minutes;
const primaryTag = post?.tags?.[0];

const formattedDate = date?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const initials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .map((part) => part[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();

const TAG_LABELS: Record<string, string> = {
  typescript: 'TypeScript',
  javascript: 'JavaScript',
  ux: 'UX',
  ai: 'AI',
};
const formatTag = (label: string) =>
  TAG_LABELS[label.toLowerCase()] ?? label.charAt(0).toUpperCase() + label.slice(1);
---

<div class="blog-header blog-header--post">
  <nav class="blog-breadcrumbs" aria-label="Breadcrumb">
    <a href="/blog/">Blog</a>
    {
      primaryTag && (
        <>
          <span class="blog-breadcrumbs-sep" aria-hidden="true">
            ›
          </span>
          <a href={primaryTag.href}>{formatTag(primaryTag.label)}</a>
        </>
      )
    }
  </nav>

  <h1 id="_top" class="blog-post-title">{title}</h1>
  {description && <p class="blog-post-subtitle">{description}</p>}

  <div class="blog-byline">
    <div class="blog-byline-info">
      {
        authors.length > 0 && (
          <div class="blog-byline-authors">
            <div class="blog-avatar-stack">
              {authors.map((author) =>
                author.image ? (
                  <img src={author.image} alt="" class="blog-avatar" width="32" height="32" />
                ) : (
                  <span class="blog-avatar blog-avatar--initials" aria-hidden="true">
                    {initials(author.name)}
                  </span>
                ),
              )}
            </div>
            <span class="blog-byline-names">
              {/* Kept on one line so Astro doesn't insert whitespace before the comma. */}
              {authors.map((author, i) => (
                <>{i > 0 && ', '}<a href={`/blog/authors/${author.slug}/`}>{author.name}</a></>
              ))}
            </span>
          </div>
        )
      }
      <span class="blog-byline-meta">
        {date && <time datetime={date.toISOString()}>{formattedDate}</time>}
        {readingMinutes ? <span> · {readingMinutes} min read</span> : null}
      </span>
    </div>
    <CopyMarkdownButton class="title-copy-button blog-copy-button" />
  </div>
</div>
