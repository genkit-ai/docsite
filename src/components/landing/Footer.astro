---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Link from './Link.astro';

import logoLight from '../../../public/genkit_logo_horizontal_light.png';
import logoKnockout from '../../../public/genkit_logo_horizontal_knockout.png';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const footerColumns = [
  {
    title: 'Capabilities',
    links: [
      { label: 'Full-Stack Agents', href: '/docs/agents/overview' },
      { label: 'Flows & Schemas', href: '/docs/flows' },
      { label: 'Tool Calling & Interrupts', href: '/docs/tool-calling' },
      { label: 'Multi-Agent Systems', href: '/docs/multi-agent' },
      { label: 'RAG & Context', href: '/docs/rag' },
      { label: 'Model Context Protocol (MCP)', href: '/docs/model-context-protocol' },
      { label: 'Generative UI (A2UI)', href: '/docs/agents/a2ui' },
    ],
  },
  {
    title: 'SDKs & Frameworks',
    links: [
      { label: 'TypeScript / Node.js', href: '/docs/js/get-started/' },
      { label: 'Go SDK', href: '/docs/go/get-started/' },
      { label: 'Python SDK', href: '/docs/python/get-started/' },
      { label: 'Dart & Flutter SDK', href: '/docs/dart/get-started/' },
      { label: 'Next.js, React & Angular', href: '/docs/app-frameworks/overview' },
      { label: 'Express, FastAPI & Gin', href: '/docs/backend-frameworks/overview' },
    ],
  },
  {
    title: 'Production & Tooling',
    links: [
      { label: 'Local Developer UI & CLI', href: '/docs/devtools' },
      { label: 'Prompt Templating (Dotprompt)', href: '/docs/dotprompt' },
      { label: 'Evaluation & Testing', href: '/docs/evaluation' },
      { label: 'Observability & Metrics', href: '/docs/observability/getting-started' },
      { label: 'Deploy to Cloud Run / Firebase', href: '/docs/deployment/any-platform' },
      { label: 'AI-Assisted Dev (Agent Skills)', href: '/docs/develop-with-ai' },
    ],
  },
  {
    title: 'Resources & Community',
    links: [
      { label: 'Documentation', href: '/docs/get-started' },
      { label: 'Genkit by Example', href: 'https://examples.genkit.dev/' },
      { label: 'Engineering Blog', href: '/blog' },
      { label: 'Product Roadmap', href: '/docs/roadmap' },
      { label: 'GitHub Repository', href: 'https://github.com/genkit-ai/genkit' },
      { label: 'Discord Community', href: 'https://discord.gg/qXt5zzQKpc' },
    ],
  },
];
---

<footer class:list={[
  '@container border-t border-(--gk-border-subtle) bg-(--gk-surface-1)/60 text-foreground not-content',
  compact ? 'mt-12 pt-12 pb-10 px-6 sm:px-8' : 'pt-16 pb-12 px-6',
]}>
  <div class="max-w-(--gk-container-max) mx-auto">
    <div class="grid grid-cols-1 @4xl:grid-cols-12 gap-10 pb-12 border-b border-(--gk-border-subtle)">
      <!-- Brand Column -->
      <div class="@4xl:col-span-4 space-y-4">
        <a href="/" class="inline-flex items-center no-underline" aria-label="Genkit Home">
          <Image
            src={logoKnockout}
            alt="Genkit"
            width={192}
            class="genkit-logo genkit-logo-knockout h-12 w-auto -ml-2"
          />
          <Image
            src={logoLight}
            alt="Genkit"
            width={192}
            class="genkit-logo genkit-logo-light h-12 w-auto -ml-2"
          />
        </a>
        <p class="text-sm text-(--gk-text-muted) leading-relaxed max-w-xs">
          Google's open-source framework for building AI-powered apps and agents in TypeScript, Go, Python, and Dart.
        </p>
        <div class="flex flex-wrap items-center gap-2 pt-1">
          <span class="gk-badge gk-badge-emerald">
            <span class="w-1.5 h-1.5 rounded-full bg-(--gk-emerald)"></span>
            Apache 2.0 License
          </span>
          <span class="gk-badge">OpenTelemetry Native</span>
        </div>
      </div>

      <!-- Navigation Columns -->
      <div class="@4xl:col-span-8 grid grid-cols-2 @2xl:grid-cols-4 gap-8">
        {footerColumns.map((column) => (
          <div>
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-foreground mb-4">
              {column.title}
            </h3>
            <ul class="space-y-2.5 list-none p-0 m-0">
              {column.links.map((item) => (
                <li>
                  <Link variant="footer" href={item.href}>
                    {item.label}
                  </Link>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Legal & Social Row -->
    <div class="pt-8 flex flex-col @xl:flex-row items-center justify-between gap-4 text-xs text-(--gk-text-muted)">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <span>Built and used in production by Google.</span>
        <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer" class="text-(--gk-text-muted) hover:text-foreground no-underline transition-colors">Terms</a>
        <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-(--gk-text-muted) hover:text-foreground no-underline transition-colors">Privacy</a>
        <a href="https://github.com/genkit-ai/genkit/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-(--gk-text-muted) hover:text-foreground no-underline transition-colors">Apache 2.0</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="https://github.com/genkit-ai/genkit" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-(--gk-text-muted) hover:text-foreground transition-colors">
          <Icon name="github" size="sm" />
        </a>
        <a href="https://discord.gg/qXt5zzQKpc" target="_blank" rel="noopener noreferrer" aria-label="Discord" class="text-(--gk-text-muted) hover:text-foreground transition-colors">
          <Icon name="discord" size="sm" />
        </a>
        <a href="https://x.com/GenkitFramework" target="_blank" rel="noopener noreferrer" aria-label="X" class="text-(--gk-text-muted) hover:text-foreground transition-colors">
          <Icon name="x" size="sm" />
        </a>
        <a href="https://www.linkedin.com/company/genkit" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-(--gk-text-muted) hover:text-foreground transition-colors">
          <Icon name="linkedin" size="sm" />
        </a>
        <a href="https://reddit.com/r/GenkitFramework" target="_blank" rel="noopener noreferrer" aria-label="Reddit" class="text-(--gk-text-muted) hover:text-foreground transition-colors">
          <Icon name="reddit" size="sm" />
        </a>
      </div>
    </div>
  </div>
</footer>
