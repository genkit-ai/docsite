---
/**
 * The hero CTA: an install command for each SDK, plus Genkit agent skills for
 * people who build with a coding agent. Below it, one button opens the
 * matching quickstart.
 *
 * The language tabs follow the site-wide language preference. The agent
 * skills tab only changes this widget (see `landing-demos.ts`).
 */
import Icon from './Icon.astro';
import { agentSkills, hero, sdks } from '../../data/landing';

interface Props {
  idPrefix: string;
  class?: string;
}

const { idPrefix, class: className } = Astro.props;
const DEFAULT_LANG = 'js';

/**
 * On narrow screens the command wraps at spaces, and a long path (like the Go
 * module) may wrap after a slash. Package names never split, not even at a
 * hyphen. The commands are static strings from `landing.ts`, so they are safe
 * to render as HTML.
 */
const commandHtml = (command: string) =>
  command
    .split(' ')
    .map((word) =>
      (word.length > 24 ? word.split(/(?<=\/)/) : [word]).map((piece) => `<span>${piece}</span>`).join('<wbr>'),
    )
    .join(' ');

const commands = [
  ...sdks.map((sdk) => ({ id: sdk.id, label: sdk.label, install: sdk.install, skills: false })),
  { id: 'skills', label: agentSkills.label, install: agentSkills.install, skills: true },
];

const sparkle = 'M12 2.5c.55 4.9 3.05 7.4 8 8-4.95.6-7.45 3.1-8 8-.55-4.9-3.05-7.4-8-8 4.95-.6 7.45-3.1 8-8Z';
---

<div class:list={['install-block', className]} data-install>
  <div class="install gk-code-window">
    <div class="install-tabs" role="tablist" aria-label="Choose how to start" data-lang-tablist>
      {sdks.map((sdk) => (
        <button
          type="button"
          role="tab"
          id={`${idPrefix}-tab-${sdk.id}`}
          class="gk-tab"
          aria-controls={`${idPrefix}-panel-${sdk.id}`}
          aria-selected={sdk.id === DEFAULT_LANG ? 'true' : 'false'}
          tabindex={sdk.id === DEFAULT_LANG ? 0 : -1}
          data-lang-tab={sdk.id}
        >
          <Icon name={sdk.icon} class={sdk.id === 'go' ? 'w-4 h-4' : 'w-3.5 h-3.5'} />
          <span>{sdk.label}</span>
        </button>
      ))}
      <button
        type="button"
        role="tab"
        id={`${idPrefix}-tab-skills`}
        class="gk-tab install-tab-skills"
        aria-controls={`${idPrefix}-panel-skills`}
        aria-selected="false"
        tabindex="-1"
        data-skills-tab
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={sparkle}></path></svg>
        <span class="label-long">{agentSkills.label}</span>
        <span class="label-short" aria-hidden="true">{agentSkills.shortLabel}</span>
      </button>
    </div>

    {commands.map((command) => (
      <div
        role="tabpanel"
        id={`${idPrefix}-panel-${command.id}`}
        aria-labelledby={`${idPrefix}-tab-${command.id}`}
        data-lang-pane={command.skills ? undefined : command.id}
        data-skills-view={command.skills ? '' : undefined}
        hidden={!command.skills && command.id !== DEFAULT_LANG}
        class="install-command"
      >
        <span class="install-prompt" aria-hidden="true">$</span>
        <code set:html={commandHtml(command.install)} />
        <button
          type="button"
          id={`${idPrefix}-copy-${command.id}`}
          class="gk-copy-btn"
          data-copy={command.install}
          aria-label={`Copy the ${command.label} install command`}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span data-copy-label aria-live="polite">Copy</span>
        </button>
      </div>
    ))}
  </div>

  <div class="install-actions">
    {sdks.map((sdk) => (
      <a
        href={sdk.quickstart}
        id={`${idPrefix}-cta-${sdk.id}`}
        class="install-cta"
        data-lang-only={sdk.id}
        hidden={sdk.id !== DEFAULT_LANG}
      >
        {hero.cta}<span class="sr-only"> ({sdk.label})</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    ))}
    <a href={agentSkills.cta.href} id={`${idPrefix}-cta-skills`} class="install-cta" data-skills-view>
      {agentSkills.cta.label}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
    </a>
  </div>
</div>

<style>
  .install {
    container-type: inline-size;
    border-radius: var(--gk-radius-lg);
    box-shadow: var(--gk-shadow-elevated);
  }

  .install-tabs {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem;
    border-bottom: 1px solid var(--color-code-border);
    overflow-x: auto;
    scrollbar-width: none;
  }

  /* Agent skills aren't a language: a hairline sets the tab apart. */
  .install-tab-skills {
    position: relative;
    margin-left: 0.5rem;
  }

  .install-tab-skills::before {
    content: '';
    position: absolute;
    top: 22%;
    bottom: 22%;
    left: calc(-0.375rem - 0.5px);
    width: 1px;
    background-color: rgb(255 255 255 / 0.12);
  }

  .install-tab-skills svg {
    color: #a8c7fa;
  }

  .label-short {
    display: none;
  }

  /* Narrow cards: shorter labels and no icons, so all five tabs stay visible. */
  @container (max-width: 29rem) {
    .install-tabs :global(svg) {
      display: none;
    }

    .install-tabs {
      gap: 0.125rem;
    }

    .install-tab-skills {
      margin-left: 0.375rem;
    }

    .install-tab-skills::before {
      left: calc(-0.25rem - 0.5px);
    }

    .label-long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .label-short {
      display: inline;
    }
  }

  .install-command {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.9rem 0.75rem 0.9rem 1rem;
  }

  .install-prompt {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: #8da8ff;
    user-select: none;
  }

  .install-command code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: #f3f5f8;
    text-wrap: balance;
  }

  .install-command code :global(span) {
    white-space: nowrap;
  }

  /* Small phones: an icon-only copy button leaves room for the command. */
  @container (max-width: 21rem) {
    .install-command [data-copy-label] {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Which view is showing: a language (the default) or agent skills. */
  .install-block:not([data-view='skills']) [data-skills-view],
  .install-block[data-view='skills'] :is([data-lang-pane], [data-lang-only]) {
    display: none;
  }

  .install-actions {
    display: flex;
    margin-top: 1.25rem;
  }

  .install-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.7rem 1.3rem 0.7rem 1.5rem;
    border-radius: var(--gk-radius-pill);
    background-color: var(--color-genkit-primary);
    color: var(--gk-accent-contrast);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .install-cta:hover {
    background-color: var(--color-genkit-primary-hover);
    color: var(--gk-accent-contrast);
  }

  .install-cta svg {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .install-cta:hover svg {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .install-cta,
    .install-cta svg {
      transition: none;
    }
  }
</style>
