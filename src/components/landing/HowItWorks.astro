---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { highlightLines } from './highlight-code';
import { howItWorks, modelChoices, sameCallPerLanguage, sdks, steps } from '../../data/landing';
import devUiScreenshot from '../../../public/assets/agent-dev-ui-1.png';

// Step 1: the same snippet with each model. Only the `model:` line differs.
const MODEL_LINE = 5;
const modelSnippet = (ref: string) => `const ai = genkit({
  plugins: [googleAI(), anthropic(), openAI(), ollama()],
});

const { text } = await ai.generate({
  model: ${ref},
  prompt: 'Summarize this support ticket',
});`;

const highlightedByModel = await Promise.all(
  modelChoices.map((model) => highlightLines(modelSnippet(model.ref), 'ts')),
);

const modelCodeHtml = highlightedByModel[0]
  .map((lineHtml, index) => {
    if (index !== MODEL_LINE) return `<span class="line">${lineHtml}</span>`;
    const variants = modelChoices
      .map(
        (model, variantIndex) =>
          `<span data-model-line="${model.id}"${variantIndex === 0 ? '' : ' hidden'}>${highlightedByModel[variantIndex][index]}</span>`,
      )
      .join('');
    return `<span class="line is-hl">${variants}</span>`;
  })
  .join('\n');

// Step 2: one call, four SDKs.
const sameCall = await Promise.all(
  sdks.map(async (sdk) => ({
    ...sdk,
    html: (await highlightLines(sameCallPerLanguage[sdk.id], sdk.id === 'js' ? 'ts' : sdk.id))[0],
  })),
);

const [modelsStep, languagesStep, agentsStep, shipStep] = steps;

// Step 3: an example coding-agent session. Tool names match the Genkit MCP server.
const agentSession = [
  { kind: 'skill', detail: 'developing-genkit-js' },
  { kind: 'edit', detail: 'src/flows/summarize-ticket.ts' },
  { kind: 'mcp', detail: 'run_flow summarizeTicket' },
  { kind: 'mcp', detail: 'get_trace → generate · output' },
];
---

<section id="how-it-works" class="gk-section gk-section-divider" aria-labelledby="how-it-works-title">
  <div class="gk-container">
    <div class="max-w-3xl mb-12">
      <h2 id="how-it-works-title" class="gk-h2 landing-h2 mb-4">{howItWorks.title}</h2>
      <p class="gk-lead m-0">{howItWorks.lead}</p>
    </div>

    <ol class="grid grid-cols-1 xl:grid-cols-2 gap-5 list-none p-0 m-0">
      <!-- 1. Pick any model -->
      <li class="gk-card p-6 sm:p-8 flex flex-col">
        <p class="font-mono text-xs font-semibold text-(--gk-text-muted) mb-3" aria-hidden="true">01</p>
        <h3 class="gk-h3 mb-2">{modelsStep.title}</h3>
        <p class="text-(--gk-text-secondary) leading-relaxed mb-6">{modelsStep.body}</p>

        <div class="gk-code-window mt-auto" data-model-switcher>
          <div class="flex items-center gap-1 px-2 py-2 border-b border-(--color-code-border) overflow-x-auto [scrollbar-width:none]" role="group" aria-label="Choose a model">
            {modelChoices.map((model, index) => (
              <button
                type="button"
                id={`model-switch-${model.id}`}
                class="gk-tab"
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-model-btn={model.id}
              >
                {model.label}
              </button>
            ))}
            <span class="hidden sm:inline ml-auto pl-3 font-mono text-[11px] text-[#8e98a8] whitespace-nowrap">index.ts</span>
          </div>
          <div class="gk-code text-[0.75rem] sm:text-[0.8125rem]">
            <pre tabindex="0"><code set:html={modelCodeHtml}></code></pre>
          </div>
        </div>
        <p class="mt-3 mb-5 text-xs text-(--gk-text-muted)">Try it: switch models. Only the highlighted line changes.</p>

        <div class="flex flex-wrap gap-x-5 gap-y-2">
          {modelsStep.links.map((link) => (
            <a href={link.href} class="text-sm font-medium text-genkit-primary hover:text-genkit-primary-hover no-underline">{link.label} →</a>
          ))}
        </div>
      </li>

      <!-- 2. Build in your language -->
      <li class="gk-card p-6 sm:p-8 flex flex-col">
        <p class="font-mono text-xs font-semibold text-(--gk-text-muted) mb-3" aria-hidden="true">02</p>
        <h3 class="gk-h3 mb-2">{languagesStep.title}</h3>
        <p class="text-(--gk-text-secondary) leading-relaxed mb-6">{languagesStep.body}</p>

        <ul class="gk-code-window mt-auto list-none p-0 m-0 divide-y divide-(--color-code-border)" aria-label="The same model call in each SDK">
          {sameCall.map((sdk) => (
            <li class="px-4 py-3">
              <div class="flex items-center gap-2 mb-1.5">
                <Icon name={sdk.icon} class={sdk.id === 'go' ? 'w-5 h-5 shrink-0' : 'w-4 h-4 shrink-0'} />
                <span class="text-xs font-medium text-[#c9d1d9]">{sdk.label}</span>
                <span
                  class:list={[
                    'ml-auto text-[10px] font-mono uppercase px-1.5 py-0.5 rounded',
                    sdk.status === 'GA' ? 'bg-[#34d399]/12 text-[#34d399]' : 'bg-white/8 text-[#8e98a8]',
                  ]}
                >
                  {sdk.status}
                </span>
              </div>
              <code class="block overflow-x-auto whitespace-nowrap font-mono text-[0.75rem] sm:text-[0.8125rem] [scrollbar-width:none]" set:html={sdk.html} />
            </li>
          ))}
        </ul>
        <p class="mt-3 mb-5 text-xs text-(--gk-text-muted)">TypeScript and Go are generally available. Python and Dart are in preview.</p>

        <div class="flex flex-wrap gap-x-5 gap-y-2">
          {languagesStep.links.map((link) => (
            <a href={link.href} data-genkit-docs-entry class="text-sm font-medium text-genkit-primary hover:text-genkit-primary-hover no-underline">{link.label} →</a>
          ))}
        </div>
      </li>

      <!-- 3. Build it with your coding agent -->
      <li class="gk-card p-6 sm:p-8 xl:col-span-2 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-5 lg:order-2">
          <p class="font-mono text-xs font-semibold text-(--gk-text-muted) mb-3" aria-hidden="true">03</p>
          <h3 class="gk-h3 mb-2">{agentsStep.title}</h3>
          <p class="text-(--gk-text-secondary) leading-relaxed mb-6">{agentsStep.body}</p>
          <div class="flex flex-wrap gap-x-5 gap-y-2">
            {agentsStep.links.map((link) => (
              <a href={link.href} class="text-sm font-medium text-genkit-primary hover:text-genkit-primary-hover no-underline">{link.label} →</a>
            ))}
          </div>
        </div>

        <figure class="lg:col-span-7 lg:order-1 m-0">
          <div class="gk-code-window">
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-(--color-code-border)" aria-hidden="true">
              <Icon name="code" class="w-4 h-4 text-[#8e98a8]" />
              <span class="font-mono text-[11px] text-[#8e98a8]">coding agent</span>
              <span class="ml-auto font-mono text-[11px] text-[#8e98a8]">genkit mcp · skills</span>
            </div>
            <ol class="list-none m-0 p-4 sm:p-5 space-y-3 font-mono text-[0.75rem] sm:text-[0.8125rem] leading-relaxed">
              <li class="text-[#c9d1d9]">
                <span class="text-[#8e98a8]">you ›</span> Add a flow that summarizes support tickets and tags their priority.
              </li>
              {agentSession.map((row) => (
                <li class="flex gap-3 items-baseline">
                  <span class="text-[#34d399] shrink-0" aria-hidden="true">✓</span>
                  <span class="text-[#8e98a8] w-14 shrink-0">{row.kind}</span>
                  <span class="text-[#c9d1d9] min-w-0 break-words">{row.detail}</span>
                </li>
              ))}
              <li class="text-[#c9d1d9] pt-1 border-t border-(--color-code-border)">
                <span class="text-[#8e98a8]">agent ›</span> Done. <span class="text-[#79c0ff]">summarizeTicket</span> returns a summary and a priority, and the trace shows each step ran as expected.
              </li>
            </ol>
          </div>
          <figcaption class="mt-3 text-xs text-(--gk-text-muted)">
            Example: a coding agent writes a flow with Genkit agent skills, then runs it and reads its trace through the Genkit MCP server.
          </figcaption>
        </figure>
      </li>

      <!-- 4. Test it, then ship it -->
      <li class="gk-card p-6 sm:p-8 xl:col-span-2 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-5">
          <p class="font-mono text-xs font-semibold text-(--gk-text-muted) mb-3" aria-hidden="true">04</p>
          <h3 class="gk-h3 mb-2">{shipStep.title}</h3>
          <p class="text-(--gk-text-secondary) leading-relaxed mb-6">{shipStep.body}</p>
          <div class="flex flex-wrap gap-x-5 gap-y-2">
            {shipStep.links.map((link) => (
              <a href={link.href} class="text-sm font-medium text-genkit-primary hover:text-genkit-primary-hover no-underline">{link.label} →</a>
            ))}
          </div>
        </div>

        <figure class="lg:col-span-7 m-0">
          <div class="gk-browser">
            <div class="flex items-center gap-3 px-3 py-2 bg-[#25262b] border-b border-white/10" aria-hidden="true">
              <span class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-white/15"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-white/15"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-white/15"></span>
              </span>
              <span class="flex-1 max-w-64 mx-auto text-center rounded-md bg-black/30 px-3 py-0.5 font-mono text-[11px] text-[#9aa3b2]">localhost:4000</span>
              <span class="w-[2.625rem]"></span>
            </div>
            <Image
              src={devUiScreenshot}
              alt="The Genkit Developer UI running an agent: the user's message, the tool the model called with its input and result, the model's reply, and the agent's session state."
              widths={[640, 960, 1320]}
              sizes="(min-width: 1216px) 660px, (min-width: 1024px) 55vw, 100vw"
              class="block w-full h-auto"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-3 text-xs text-(--gk-text-muted)">
            The Developer UI shows every step your AI feature takes, so you can see why it did what it did.
          </figcaption>
        </figure>
      </li>
    </ol>
  </div>
</section>
