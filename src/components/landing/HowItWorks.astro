---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { highlightLines } from './highlight-code';
import { howItWorks, modelChoices, sameCallPerLanguage, sdks, steps } from '../../data/landing';
import devUiScreenshot from '../../../public/assets/agent-dev-ui-1.png';

/*
 * "How it works" is a vertical stepper. On wide screens, the steps scroll past
 * a sticky stage that shows the active step's visual. On small screens, each
 * visual sits under its step. `landing-demos.ts` marks the active step and
 * fills the rail as you scroll. Without JS, every step and visual shows in
 * order.
 */

// Step 1: the same snippet with each model. Only the `model:` line differs.
const MODEL_LINE = 5;
const modelSnippet = (ref: string) => `const ai = genkit({
  plugins: [googleAI(), anthropic(), openAI(), ollama()],
});

const { text } = await ai.generate({
  model: ${ref},
  prompt: 'Summarize this support ticket',
});`;

const highlightedByModel = await Promise.all(
  modelChoices.map((model) => highlightLines(modelSnippet(model.ref), 'ts')),
);

const modelCodeHtml = highlightedByModel[0]
  .map((lineHtml, index) => {
    if (index !== MODEL_LINE) return `<span class="line">${lineHtml}</span>`;
    const variants = modelChoices
      .map(
        (model, variantIndex) =>
          `<span data-model-line="${model.id}"${variantIndex === 0 ? '' : ' hidden'}>${highlightedByModel[variantIndex][index]}</span>`,
      )
      .join('');
    return `<span class="line is-hl">${variants}</span>`;
  })
  .join('\n');

// Step 2: one call, four SDKs.
const sameCall = await Promise.all(
  sdks.map(async (sdk) => ({
    ...sdk,
    html: (await highlightLines(sameCallPerLanguage[sdk.id], sdk.id === 'js' ? 'ts' : sdk.id))[0],
  })),
);

// Step 3: an example coding-agent session. Tool names match the Genkit MCP server.
const agentSession = [
  { kind: 'skill', detail: 'developing-genkit-js' },
  { kind: 'edit', detail: 'src/flows/summarize-ticket.ts' },
  { kind: 'mcp', detail: 'run_flow summarizeTicket' },
  { kind: 'mcp', detail: 'get_trace → generate · output' },
];
---

<section id="how-it-works" class="gk-section gk-section-divider" aria-labelledby="how-it-works-title">
  <div class="gk-container">
    <div class="max-w-3xl mb-12 lg:mb-14">
      <h2 id="how-it-works-title" class="gk-h2 landing-h2 mb-4">{howItWorks.title}</h2>
      <p class="gk-lead m-0">{howItWorks.lead}</p>
    </div>

    <div class="hiw" data-hiw>
      <div class="hiw-rail" aria-hidden="true">
        <span class="hiw-rail-fill" data-hiw-fill></span>
        <span class="hiw-rail-tip" data-hiw-tip></span>
      </div>

      <ol class="hiw-steps" style={`--hiw-count: ${steps.length}`}>
        {steps.map((step, index) => (
          <li class="hiw-step" data-hiw-step data-state={index === 0 ? 'active' : 'upcoming'}>
            <div class="hiw-text">
              <div class="hiw-copy">
                <div class="hiw-head">
                  <span class="hiw-node" data-hiw-node aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3 class="gk-h3 hiw-title">{step.title}</h3>
                </div>
                <p class="hiw-body">{step.body}</p>
                <div class="hiw-links">
                  {step.links.map((link) => (
                    <a
                      href={link.href}
                      class="hiw-link"
                      data-genkit-docs-entry={step.id === 'languages' ? '' : undefined}
                    >
                      {link.label}
                      <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <div class="hiw-visual">
              {step.id === 'models' && (
                <figure class="hiw-figure">
                  <div class="gk-code-window hiw-window" data-model-switcher>
                    <div
                      class="flex items-center gap-1 px-2 py-2 border-b border-(--color-code-border) overflow-x-auto [scrollbar-width:none]"
                      role="group"
                      aria-label="Choose a model"
                    >
                      {modelChoices.map((model, modelIndex) => (
                        <button
                          type="button"
                          id={`model-switch-${model.id}`}
                          class="gk-tab"
                          aria-pressed={modelIndex === 0 ? 'true' : 'false'}
                          data-model-btn={model.id}
                        >
                          {model.label}
                        </button>
                      ))}
                      <span class="hidden sm:inline ml-auto pl-3 font-mono text-[11px] text-[#8e98a8] whitespace-nowrap">
                        index.ts
                      </span>
                    </div>
                    <div class="gk-code text-[0.75rem] sm:text-[0.8125rem]">
                      <pre tabindex="0"><code set:html={modelCodeHtml} /></pre>
                    </div>
                  </div>
                  <figcaption class="hiw-caption">Try it: switch models. Only the highlighted line changes.</figcaption>
                </figure>
              )}

              {step.id === 'languages' && (
                <figure class="hiw-figure">
                  <ul
                    class="gk-code-window hiw-window list-none p-0 m-0 divide-y divide-(--color-code-border)"
                    aria-label="The same model call in each SDK"
                  >
                    {sameCall.map((sdk) => (
                      <li class="px-4 py-3">
                        <div class="flex items-center gap-2 mb-1.5">
                          <Icon name={sdk.icon} class={sdk.id === 'go' ? 'w-5 h-5 shrink-0' : 'w-4 h-4 shrink-0'} />
                          <span class="text-xs font-medium text-[#c9d1d9]">{sdk.label}</span>
                          <span
                            class:list={[
                              'ml-auto text-[10px] font-mono uppercase px-1.5 py-0.5 rounded',
                              sdk.status === 'GA' ? 'bg-[#34d399]/12 text-[#34d399]' : 'bg-white/8 text-[#8e98a8]',
                            ]}
                          >
                            {sdk.status}
                          </span>
                        </div>
                        <code
                          class="block overflow-x-auto whitespace-nowrap font-mono text-[0.75rem] sm:text-[0.8125rem] [scrollbar-width:none]"
                          set:html={sdk.html}
                        />
                      </li>
                    ))}
                  </ul>
                  <figcaption class="hiw-caption">
                    TypeScript and Go are generally available. Python and Dart are in preview.
                  </figcaption>
                </figure>
              )}

              {step.id === 'agents' && (
                <figure class="hiw-figure">
                  <div class="gk-code-window hiw-window">
                    <div class="flex items-center gap-2 px-4 py-2.5 border-b border-(--color-code-border)" aria-hidden="true">
                      <Icon name="code" class="w-4 h-4 text-[#8e98a8]" />
                      <span class="font-mono text-[11px] text-[#8e98a8]">coding agent</span>
                      <span class="ml-auto font-mono text-[11px] text-[#8e98a8]">genkit mcp · skills</span>
                    </div>
                    <ol class="list-none m-0 p-4 sm:p-5 space-y-3 font-mono text-[0.75rem] sm:text-[0.8125rem] leading-relaxed">
                      <li class="text-[#c9d1d9]">
                        <span class="text-[#8e98a8]">you ›</span> Add a flow that summarizes support tickets and tags their
                        priority.
                      </li>
                      {agentSession.map((row) => (
                        <li class="flex gap-3 items-baseline">
                          <span class="text-[#34d399] shrink-0" aria-hidden="true">✓</span>
                          <span class="text-[#8e98a8] w-14 shrink-0">{row.kind}</span>
                          <span class="text-[#c9d1d9] min-w-0 break-words">{row.detail}</span>
                        </li>
                      ))}
                      <li class="text-[#c9d1d9] pt-3 border-t border-(--color-code-border)">
                        <span class="text-[#8e98a8]">agent ›</span> Done. <span class="text-[#79c0ff]">summarizeTicket</span> returns
                        a summary and a priority, and the trace shows each step ran as expected.
                      </li>
                    </ol>
                  </div>
                  <figcaption class="hiw-caption">
                    Example: a coding agent writes a flow with Genkit agent skills, then runs it and reads its trace through
                    the Genkit MCP server.
                  </figcaption>
                </figure>
              )}

              {step.id === 'ship' && (
                <figure class="hiw-figure">
                  <div class="gk-browser">
                    <div class="flex items-center gap-3 px-3 py-2 bg-[#25262b] border-b border-white/10" aria-hidden="true">
                      <span class="flex items-center gap-1.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-white/15" />
                        <span class="w-2.5 h-2.5 rounded-full bg-white/15" />
                        <span class="w-2.5 h-2.5 rounded-full bg-white/15" />
                      </span>
                      <span class="flex-1 max-w-64 mx-auto text-center rounded-md bg-black/30 px-3 py-0.5 font-mono text-[11px] text-[#9aa3b2]">
                        localhost:4000
                      </span>
                      <span class="w-[2.625rem]" />
                    </div>
                    <Image
                      src={devUiScreenshot}
                      alt="The Genkit Developer UI running an agent: the user's message, the tool the model called with its input and result, the model's reply, and the agent's session state."
                      widths={[640, 960, 1320]}
                      sizes="(min-width: 1024px) 580px, calc(100vw - 6rem)"
                      class="block w-full h-auto"
                      loading="lazy"
                    />
                  </div>
                </figure>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .hiw {
    --hiw-node: 2.25rem;
    --hiw-gap: 1rem;
    --hiw-indent: calc(var(--hiw-node) + var(--hiw-gap));
    --hiw-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    max-width: 48rem;
  }

  .hiw-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hiw-step + .hiw-step {
    margin-top: 4rem;
  }

  /* ---- Copy ---- */
  .hiw-copy {
    max-width: 32rem;
  }

  .hiw-head {
    display: flex;
    align-items: center;
    gap: var(--hiw-gap);
    margin-bottom: 0.75rem;
  }

  .hiw-node {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: var(--hiw-node);
    height: var(--hiw-node);
    border: 1px solid var(--gk-border-default);
    border-radius: var(--gk-radius-pill);
    background-color: var(--gk-canvas);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gk-text-muted);
    transition:
      color 0.3s ease,
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .hiw-title {
    margin: 0;
    font-size: clamp(1.25rem, 1.9vw, 1.625rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    transition: color 0.3s ease;
  }

  .hiw-body,
  .hiw-links {
    padding-left: var(--hiw-indent);
  }

  .hiw-body {
    margin: 0 0 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--gk-text-secondary);
    text-wrap: pretty;
    transition: color 0.3s ease;
  }

  .hiw-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .hiw-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-genkit-primary);
    text-decoration: none;
  }

  .hiw-link:hover {
    color: var(--color-genkit-primary-hover);
  }

  .hiw-link span {
    transition: transform 0.2s var(--hiw-ease);
  }

  .hiw-link:hover span {
    transform: translateX(3px);
  }

  /* ---- Visuals ---- */
  .hiw-visual {
    margin: 1.75rem 0 0 var(--hiw-indent);
  }

  .hiw-figure {
    margin: 0;
  }

  .hiw-window {
    box-shadow: var(--gk-shadow-elevated);
  }

  .hiw-caption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--gk-text-muted);
  }

  /* ---- Rail: fills down to the focus line as you scroll (JS only) ---- */
  .hiw-rail {
    display: none;
  }

  :global(html.js) .hiw-rail {
    display: block;
    position: absolute;
    top: 0;
    left: calc(var(--hiw-node) / 2 - 1px);
    width: 2px;
    border-radius: 2px;
    background-color: var(--gk-border-default);
    pointer-events: none;
  }

  .hiw-rail-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-genkit-primary) 25%, transparent),
      var(--color-genkit-primary)
    );
    transform: scaleY(0);
    transform-origin: top;
  }

  .hiw-rail-tip {
    position: absolute;
    top: -0.25rem;
    left: -3px;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--gk-radius-pill);
    background-color: var(--color-genkit-primary);
    box-shadow: 0 0 0 3px var(--gk-canvas);
  }

  /* ---- Step states, set by landing-demos.ts ---- */
  :global(html.js) .hiw-step[data-state='done'] .hiw-node {
    border-color: transparent;
    background-color: color-mix(in srgb, var(--color-genkit-primary) 16%, var(--gk-canvas));
    color: var(--color-genkit-primary);
  }

  :global(html.js) .hiw-step[data-state='active'] .hiw-node {
    border-color: var(--color-genkit-primary);
    background-color: var(--color-genkit-primary);
    color: var(--gk-accent-contrast);
    animation: hiw-node-pop 0.5s var(--hiw-ease);
  }

  @keyframes hiw-node-pop {
    from {
      transform: scale(0.8);
    }
    60% {
      transform: scale(1.08);
    }
    to {
      transform: none;
    }
  }

  /* ---- Wide screens: steps on the left, a sticky stage on the right ---- */
  @media (min-width: 64rem) {
    :global(html.js) .hiw {
      --hiw-nav: 4rem;
      --hiw-stage-h: 30rem;
      /* Centered in the space under the nav, so it lines up with the focus line. */
      --hiw-stage-top: max(
        calc(var(--hiw-nav) + 1.5rem),
        calc(var(--hiw-nav) + (100vh - var(--hiw-nav) - var(--hiw-stage-h)) / 2)
      );
      max-width: none;
    }

    :global(html.js) .hiw-steps {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: repeat(var(--hiw-count), auto);
      column-gap: clamp(2.5rem, 5vw, 5rem);
    }

    /* Each step's copy and visual join the grid directly. */
    :global(html.js) .hiw-step {
      display: contents;
    }

    :global(html.js) .hiw-text {
      grid-column: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      /* Short enough that the steps before and after stay in view. */
      min-height: max(19rem, 40vh);
    }

    /* The stage and every visual share one sticky cell in the right column. */
    :global(html.js) .hiw-steps::after,
    :global(html.js) .hiw-visual {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: start;
      position: sticky;
      top: var(--hiw-stage-top);
      height: var(--hiw-stage-h);
    }

    :global(html.js) .hiw-steps::after {
      content: '';
      z-index: 0;
      border: 1px solid var(--gk-border-subtle);
      border-radius: var(--gk-radius-xl);
      background:
        radial-gradient(55% 50% at 50% 52%, color-mix(in srgb, var(--color-genkit-primary) 11%, transparent), transparent 72%),
        radial-gradient(120% 75% at 0% 0%, color-mix(in srgb, var(--color-genkit-primary) 8%, transparent), transparent 60%),
        radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--gk-cyan) 6%, transparent), transparent 65%),
        var(--gk-surface-1);
      box-shadow: var(--gk-shadow-card);
    }

    :global(html.js) .hiw-visual {
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin: 0;
      padding: clamp(1.5rem, 2.4vw, 2.25rem);
      opacity: 0;
      visibility: hidden;
      transform: translateY(1.5rem) scale(0.98);
      transition:
        opacity 0.3s ease,
        transform 0.5s var(--hiw-ease),
        visibility 0s linear 0.3s;
    }

    /* Visuals you've scrolled past leave upward; upcoming ones wait below. */
    :global(html.js) .hiw-step[data-state='done'] .hiw-visual {
      transform: translateY(-1.5rem) scale(0.98);
    }

    :global(html.js) .hiw-step[data-state='active'] .hiw-visual {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.45s ease 0.1s,
        transform 0.7s var(--hiw-ease) 0.1s,
        visibility 0s;
    }

    /* Steps that aren't active recede. Clicking one brings it into focus. */
    :global(html.js) .hiw-step:not([data-state='active']) :is(.hiw-title, .hiw-body) {
      color: var(--gk-text-muted);
    }

    :global(html.js) .hiw-step:not([data-state='active']) .hiw-copy {
      cursor: pointer;
    }

    :global(html.js) .hiw-step:not([data-state='active']) .hiw-copy:hover .hiw-title {
      color: var(--gk-text-primary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw-node,
    .hiw-title,
    .hiw-body,
    .hiw-link span,
    .hiw-visual {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
