---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href: string;
  id?: string;
  target?: string;
  rel?: string;
  class?: string;
  /** Rewrites `/docs/<slug>` to the visitor's preferred SDK language on load. */
  docsEntry?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  id,
  target,
  rel,
  class: className = '',
  docsEntry = false,
} = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center gap-2 border rounded-full font-display transition-all duration-200 no-underline cursor-pointer select-none whitespace-nowrap';

const sizes = {
  sm: 'px-4 py-1.5 text-xs font-medium min-h-[2.125rem]',
  md: 'px-5 py-2.5 text-sm font-medium min-h-[2.625rem]',
  lg: 'px-7 py-3.5 text-base font-medium min-h-[3.25rem]',
} as const;

const variants = {
  primary:
    'bg-genkit-primary hover:bg-genkit-primary-hover border-genkit-primary hover:border-genkit-primary-hover text-(--gk-accent-contrast) font-semibold shadow-sm hover:-translate-y-0.5',
  secondary:
    'bg-(--gk-surface-2) hover:bg-(--gk-surface-3) border-(--gk-border-default) hover:border-(--gk-border-strong) text-foreground font-medium hover:-translate-y-0.5',
  ghost:
    'bg-transparent hover:bg-(--color-surface-subtle) border-transparent hover:border-(--gk-border-subtle) text-(--gk-text-secondary) hover:text-foreground font-medium',
} as const;

const buttonClasses = `${baseStyles} ${sizes[size]} ${variants[variant]} ${className}`;
---

<a
  id={id}
  class={buttonClasses}
  href={href}
  target={target}
  rel={rel}
  data-genkit-docs-entry={docsEntry ? '' : undefined}
>
  <slot />
</a>
