---
import { faqSection, faqs } from '../../data/landing';
---

<section id="faq" class="gk-section gk-section-divider" aria-labelledby="faq-title">
  <div class="gk-container grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
    <div class="lg:col-span-5">
      <h2 id="faq-title" class="gk-h2 landing-h2 mb-4">{faqSection.title}</h2>
      <p class="text-(--gk-text-secondary) leading-relaxed">
        {faqSection.lead}
        <a href={faqSection.discord.href} class="font-medium text-genkit-primary hover:text-genkit-primary-hover no-underline">{faqSection.discord.label}</a>.
      </p>
    </div>

    <div class="lg:col-span-7 border-t border-(--gk-border-subtle)">
      {faqs.map((faq, index) => (
        <details class="faq-item group border-b border-(--gk-border-subtle)" open={index === 0}>
          <summary class="flex items-center justify-between gap-6 py-5 cursor-pointer list-none">
            <h3 class="m-0 text-base sm:text-lg font-display font-medium leading-snug text-foreground">{faq.question}</h3>
            <span class="faq-icon shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-full border border-(--gk-border-default) text-(--gk-text-muted)" aria-hidden="true">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
              </svg>
            </span>
          </summary>
          <div class="pb-6 pr-12 text-(--gk-text-secondary) leading-relaxed">
            <p class="m-0 text-(--gk-text-secondary)">{faq.answer}</p>
            {faq.link && (
              <a href={faq.link.href} class="inline-flex mt-3 text-sm font-medium text-genkit-primary hover:text-genkit-primary-hover no-underline">
                {faq.link.label} →
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover h3 {
    color: var(--color-genkit-primary);
  }

  .faq-icon {
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon {
      transition: none;
    }
  }
</style>
