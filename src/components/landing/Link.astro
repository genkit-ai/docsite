---
type LinkVariant = 'card' | 'footer' | 'nav';

interface Props {
  variant: LinkVariant;
  href: string;
  id?: string;
  class?: string;
}

const { variant, href, id, class: className } = Astro.props;

const baseStyles = 'inline-flex items-center gap-1.5 no-underline transition-colors duration-200';

const variants = {
  card: `text-sm font-medium text-genkit-primary hover:text-genkit-primary-hover ${baseStyles}`,
  footer: `text-sm text-(--gk-text-muted) hover:text-foreground ${baseStyles}`,
  nav: `text-sm font-medium text-(--gk-text-secondary) hover:text-foreground ${baseStyles}`,
} as const;
---

<a id={id} href={href} class={`${variants[variant]} ${className || ''}`}>
  <slot />
</a>