---
// src/components/InfoCard.astro
interface Props {
  title: string;
  learnMoreUrl: string;
  learnMoreText?: string;
}

const { title, learnMoreUrl } = Astro.props;
const learnMoreText = Astro.props.learnMoreText ?? 'Learn more →';
---

<a href={learnMoreUrl} class="card clickable-block">
  <p class="title sl-flex">
    <span set:html={title} />
  </p>
  <div class="body max-sm:hidden">
    <slot />
  </div>
  {learnMoreUrl && <div class="learnmore">{learnMoreText}</div>}
</a>

<style>
  .clickable-block {
    display: flex;
    flex-direction: column;
    background-color: var(--gk-surface-1);
    border: 1px solid var(--gk-border-subtle);
    border-radius: var(--gk-radius-lg);
    box-shadow: var(--gk-shadow-sm);
    color: var(--gk-text-primary);
    text-decoration: none;
    transition:
      border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .clickable-block:hover,
  .clickable-block:focus {
    background-color: var(--gk-surface-2);
    border-color: var(--gk-border-default);
    transform: translateY(-2px);
    outline: none;
  }

  .clickable-block:focus-visible {
    outline: 2px solid var(--color-genkit-primary);
    outline-offset: 2px;
  }

  .card {
    padding: 1.5rem;
    width: 100%;
    height: auto;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: var(--gk-text-primary);
  }

  .body {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--gk-text-muted);
    flex-shrink: 1;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .learnmore {
    margin-top: auto;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-genkit-primary);
  }
</style>
