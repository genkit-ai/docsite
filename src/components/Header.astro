---
import { Image } from "astro:assets";
import Search from "virtual:starlight/components/Search";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import config from "virtual:starlight/user-config";

import logoLight from "../../public/genkit_logo_horizontal_light.png";
import logoKnockout from "../../public/genkit_logo_horizontal_knockout.png";
import Icon from "./landing/Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

let isStarlight = false;
let hasSidebar = false;
try {
  const route = Astro.locals.starlightRoute;
  isStarlight = Boolean(route);
  hasSidebar = Boolean(route?.hasSidebar);
} catch {
  isStarlight = false;
  hasSidebar = false;
}

const hasMobileMenu = isStarlight && hasSidebar;
// The landing page (the only non-Starlight page) has extra section links, a
// CTA, and its own mobile drawer, so it switches to the full nav at `lg` and
// only shows the social icons once there is room for them at `xl`.
const responsiveShow = hasMobileMenu
  ? "min-[50rem]:flex"
  : isStarlight
    ? "md:flex"
    : "lg:flex";
const socialShow = hasMobileMenu
  ? "hidden min-[50rem]:flex"
  : isStarlight
    ? "hidden sm:flex"
    : "hidden xl:flex";

const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/\/$/, "");
const isLanding = normalizedPath === "" || normalizedPath === "/";
const isRoadmap = normalizedPath === "/docs/roadmap";
const isDocs = pathname.startsWith("/docs") && !isRoadmap;
const isBlog =
  normalizedPath === "/blog" || normalizedPath.startsWith("/blog/");

const shouldRenderSearch =
  isStarlight &&
  (config.pagefind ||
    config.components.Search !== "@astrojs/starlight/components/Search.astro");

type LocalIconName = "github" | "discord" | "x" | "linkedin" | "reddit" | "rss";

const socialIconMap: Record<string, LocalIconName> = {
  github: "github",
  discord: "discord",
  "x.com": "x",
  twitter: "x",
  linkedin: "linkedin",
  reddit: "reddit",
  rss: "rss",
};

const socialLinks = (config.social ?? []).flatMap((entry) => {
  const name = socialIconMap[entry.icon];
  return name ? [{ ...entry, name }] : [];
});
---

<div
  class="genkit-header flex items-center justify-between h-full max-w-(--gk-container-max) mx-auto w-full text-foreground"
>
  <div class="flex items-center gap-6 lg:gap-8 min-w-0">
    <a href="/" class="flex items-center shrink-0 group" aria-label="Genkit home">
      <Image
        src={logoKnockout}
        alt="Genkit"
        width={224}
        class="genkit-logo genkit-logo-knockout relative top-[-1px] h-14 w-auto transition-opacity group-hover:opacity-90"
      />
      <Image
        src={logoLight}
        alt="Genkit"
        width={224}
        class="genkit-logo genkit-logo-light relative top-[-1px] h-14 w-auto transition-opacity group-hover:opacity-90"
      />
    </a>
    <div
      class:list={[
        "hidden items-center font-medium gap-1 lg:gap-1.5 *:px-3 *:py-1.5 *:rounded-lg *:text-sm *:text-(--gk-text-secondary) *:no-underline *:whitespace-nowrap *:transition-all *:duration-150 *:hover:text-foreground *:hover:bg-(--color-surface-subtle) *:aria-[current=page]:text-genkit-primary *:aria-[current=page]:bg-(--gk-accent-subtle)",
        responsiveShow,
      ]}
    >
      {isLanding && (
        <>
          <a href="#what-you-can-build">What you can build</a>
          <a href="#how-it-works">How it works</a>
        </>
      )}
      <a
        href="/docs/get-started"
        data-genkit-docs-entry
        aria-current={isDocs ? "page" : undefined}>Docs</a
      >
      <a href="/blog" aria-current={isBlog ? "page" : undefined}>Blog</a>
      <a
        href="/docs/roadmap"
        aria-current={isRoadmap ? "page" : undefined}>Roadmap</a
      >
    </div>
  </div>

  <div class="flex items-center gap-2 sm:gap-3">
    {
      shouldRenderSearch && (
        <div>
          <Search />
        </div>
      )
    }
    <div
      class:list={[
        "items-center gap-0.5 *:inline-flex *:items-center *:justify-center *:w-8 *:h-8 *:rounded-lg *:text-(--gk-text-muted) *:transition-colors *:duration-150 *:hover:text-foreground *:hover:bg-(--color-surface-subtle)",
        socialShow,
      ]}
    >
      {
        socialLinks.map(({ href, label, name }) => (
          <a href={href} aria-label={label} target="_blank" rel="noopener noreferrer">
            <Icon name={name} size="sm" />
          </a>
        ))
      }
    </div>
    {
      isStarlight ? (
        <div class="hidden min-[50rem]:flex items-center gap-2 border-l border-border-muted h-8 pl-3 ml-1">
          <ThemeToggle />
          <LanguageSelect />
        </div>
      ) : (
        <div class="flex items-center gap-2 border-l border-border-muted pl-2 sm:pl-3 ml-1">
          <ThemeToggle />
          <a
            href="/docs/get-started"
            data-genkit-docs-entry
            id="nav-get-started-cta"
            class="hidden sm:inline-flex items-center justify-center px-4 py-1.5 rounded-full text-xs font-display font-semibold whitespace-nowrap bg-genkit-primary hover:bg-genkit-primary-hover text-(--gk-accent-contrast) no-underline transition-all duration-150"
          >
            Get Started
          </a>
          <button
            id="landing-mobile-menu-btn"
            type="button"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="landing-mobile-drawer"
            class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-lg border border-border-muted bg-(--gk-surface-2) text-(--gk-text-secondary) hover:text-foreground transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" x2="20" y1="6" y2="6"></line>
              <line x1="4" x2="20" y1="12" y2="12"></line>
              <line x1="4" x2="20" y1="18" y2="18"></line>
            </svg>
          </button>
        </div>
      )
    }
  </div>
</div>

{!isStarlight && (
  <div
    id="landing-mobile-drawer"
    class="hidden lg:hidden absolute top-16 left-0 right-0 z-50 bg-(--gk-surface-1) border-b border-border-muted px-6 py-4 shadow-xl"
  >
    <div class="flex flex-col gap-2 *:py-2 *:px-3 *:rounded-lg *:text-sm *:font-medium *:text-(--gk-text-secondary) *:no-underline *:hover:bg-(--color-surface-subtle) *:hover:text-foreground">
      {isLanding && (
        <>
          <a href="#what-you-can-build" class="mobile-nav-link">What you can build</a>
          <a href="#how-it-works" class="mobile-nav-link">How it works</a>
        </>
      )}
      <a href="/docs/get-started" data-genkit-docs-entry class="mobile-nav-link">Documentation</a>
      <a href="/blog" class="mobile-nav-link">Blog</a>
      <a href="/docs/roadmap" class="mobile-nav-link">Roadmap</a>
    </div>
    <div class="mt-4 pt-3 border-t border-border-muted flex items-center justify-between">
      <div class="flex items-center gap-2">
        {socialLinks.map(({ href, label, name }) => (
          <a
            href={href}
            aria-label={label}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-(--gk-text-muted) hover:text-foreground"
          >
            <Icon name={name} size="sm" />
          </a>
        ))}
      </div>
      <a
        href="/docs/get-started"
        data-genkit-docs-entry
        class="inline-flex items-center justify-center px-4 py-2 rounded-full text-xs font-display font-semibold bg-genkit-primary text-(--gk-accent-contrast) no-underline"
      >
        Get Started →
      </a>
    </div>
  </div>
)}

<script>
  function initHeaderInteractions() {
    const menuBtn = document.getElementById("landing-mobile-menu-btn");
    const drawer = document.getElementById("landing-mobile-drawer");
    if (menuBtn && drawer) {
      menuBtn.addEventListener("click", () => {
        const isOpen = !drawer.classList.contains("hidden");
        drawer.classList.toggle("hidden", isOpen);
        menuBtn.setAttribute("aria-expanded", String(!isOpen));
      });
      drawer.querySelectorAll(".mobile-nav-link").forEach((link) => {
        link.addEventListener("click", () => {
          drawer.classList.add("hidden");
          menuBtn.setAttribute("aria-expanded", "false");
        });
      });
    }
  }

  document.addEventListener("astro:page-load", initHeaderInteractions);
  initHeaderInteractions();
</script>
