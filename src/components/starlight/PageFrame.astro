---
/**
 * Wraps Starlight's default page frame so the shared site footer renders once
 * per page, after the whole two-column content area (article + "On this page"
 * column), instead of inside the narrow article column.
 *
 * On desktop the footer spans the full width to the right of the docs sidebar;
 * on blog pages (no desktop sidebar) and on mobile it spans the full viewport.
 */
import DefaultPageFrame from '@astrojs/starlight/components/PageFrame.astro';
import SiteFooter from '../landing/Footer.astro';
---

<DefaultPageFrame>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
  <SiteFooter compact />
  <!-- Anchor for `<link rel="expect" href="#footer" blocking="render">` in head.astro -->
  <span id="footer" hidden aria-hidden="true"></span>
</DefaultPageFrame>
