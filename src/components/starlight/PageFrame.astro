---
/**
 * Starlight page frame with the shared site footer spanning the full width of
 * the page, including underneath the docs sidebar.
 *
 * Based on `@astrojs/starlight/components/PageFrame.astro`. The only layout
 * change is on desktop (>= 50rem): instead of a `position: fixed` sidebar with
 * the content padded to its right, the frame is a two-column grid with a sticky
 * sidebar. The sidebar stays pinned under the nav while you read, then scrolls
 * away with the page when the footer comes into view. On mobile the sidebar
 * keeps Starlight's default slide-over menu behaviour.
 */
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import SiteFooter from '../landing/Footer.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
  <div class="site-footer print:hidden">
    <SiteFooter compact />
  </div>
  <!-- Anchor for `<link rel="expect" href="#footer" blocking="render">` in head.astro -->
  <span id="footer" hidden aria-hidden="true"></span>
</div>

<style>
  @layer starlight.core {
    .page {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    :global([aria-expanded='true']) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: '';
        padding-bottom: 1px;
      }
    }

    .main-frame {
      flex: 1;
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }

      /*
       * Two columns: the sidebar (sized by its pane, so it collapses to 0 when
       * a page hides the pane, like the blog) and the content. The footer
       * spans both.
       */
      .page {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-rows: 1fr auto;
      }

      .sidebar {
        grid-column: 1;
        grid-row: 1;
      }

      .main-frame {
        grid-column: 2;
        grid-row: 1;
        /* The sidebar now takes up its own grid column. */
        padding-inline-start: 0;
      }

      .site-footer {
        grid-column: 1 / -1;
        grid-row: 2;
        /* Paint above the sidebar pane's stacking context. */
        position: relative;
        z-index: calc(var(--sl-z-index-menu) + 1);
      }

      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        position: sticky;
        inset-block: var(--sl-nav-height) auto;
        height: calc(100vh - var(--sl-nav-height));
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
    }
  }
</style>
