---
/**
 * Unified single-click Light/Dark theme toggle button used across the entire
 * Genkit site (Landing Page, Starlight Docs, Blog, and mobile drawers).
 */
---

<button
  type="button"
  data-gk-theme-toggle
  aria-label="Toggle color theme"
  title="Toggle light/dark theme"
  class="gk-theme-toggle inline-flex items-center justify-center w-9 h-9 rounded-lg border border-border-muted bg-(--gk-surface-2) text-(--gk-text-secondary) hover:text-foreground hover:border-(--gk-border-default) transition-colors cursor-pointer shrink-0"
>
  <svg
    class="theme-icon-dark w-4 h-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    class="theme-icon-light w-4 h-4 hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  function syncAllThemeToggles() {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-gk-theme-toggle]').forEach((btn) => {
      const darkIcon = btn.querySelector('.theme-icon-dark');
      const lightIcon = btn.querySelector('.theme-icon-light');
      if (darkIcon && lightIcon) {
        darkIcon.classList.toggle('hidden', current === 'light');
        lightIcon.classList.toggle('hidden', current !== 'light');
      }
      btn.setAttribute(
        'aria-label',
        current === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
      );
    });
  }

  function initThemeToggles() {
    syncAllThemeToggles();
    document.querySelectorAll<HTMLButtonElement>('[data-gk-theme-toggle]').forEach((btn) => {
      if (btn.dataset.gkBound === 'true') return;
      btn.dataset.gkBound = 'true';
      btn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
        syncAllThemeToggles();
      });
    });
  }

  initThemeToggles();
  document.addEventListener('astro:page-load', initThemeToggles);
</script>
