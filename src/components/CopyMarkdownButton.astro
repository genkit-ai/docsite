---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  id="copy-markdown-btn"
  class={`copy-markdown-button ${className}`}
  type="button"
  aria-label="Copy page content as markdown for selected language"
  title="Copy as Markdown"
>
  <svg
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
    <path d="m4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
  </svg>
  <span class="button-text">Copy as Markdown</span>
  <span class="success-text" style="display: none;">Copied!</span>
</button>

<style>
  .copy-markdown-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--gk-border-subtle);
    border-radius: var(--gk-radius-sm);
    background: var(--gk-surface-2);
    color: var(--gk-text-secondary);
    cursor: pointer;
    transition: all 0.18s ease;
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: var(--font-sans);
    white-space: nowrap;
    height: 2.25rem;
    box-sizing: border-box;
    line-height: 1;
    margin: 0;
    text-align: center;
  }

  .copy-markdown-button:hover {
    border-color: var(--color-genkit-primary);
    background: var(--gk-surface-3);
    color: var(--gk-text-primary);
  }

  .copy-markdown-button:active {
    transform: translateY(1px);
  }

  .copy-markdown-button.copying {
    border-color: var(--color-genkit-primary);
    background: var(--color-genkit-primary);
    color: var(--gk-accent-contrast);
  }

  .copy-markdown-button svg {
    flex-shrink: 0;
  }

  @media (max-width: 50rem) {
    .copy-markdown-button .button-text {
      display: none;
    }

    .copy-markdown-button {
      padding: 0.5rem;
      min-width: 2.25rem;
      justify-content: center;
    }
  }
</style>

<script>
  import '../scripts/markdown-copy.js';
</script>
