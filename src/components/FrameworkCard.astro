---
export interface Props {
  framework: string;
  title: string;
  description?: string;
  href: string;
  /** When set, marks this card as the active SDK when `data-genkit-lang` matches this value. */
  selectedFor?: string;
}

const { framework, title, description, href, selectedFor } = Astro.props;

type IconDef = { file: string; color?: string; multiColor?: boolean };

const ICONS: Record<string, IconDef> = {
  typescript: { file: 'typescript', color: '#3178c6' },
  go: { file: 'go', color: '#00add8' },
  dart: { file: 'dart', color: '#0175c2' },
  python: { file: 'python', color: '#3776ab' },
  nextjs: { file: 'nextdotjs', color: 'var(--gk-text-primary)' },
  sveltekit: { file: 'svelte', color: '#ff3e00' },
  nuxt: { file: 'nuxt', color: '#00dc82' },
  'tanstack-start': { file: 'tanstack', color: '#ff4154' },
  astro: { file: 'astro', color: '#ff5d01' },
  angular: { file: 'angular', color: '#dd0031' },
  react: { file: 'react', color: '#61dafb' },
  remix: { file: 'remix', color: 'var(--gk-text-primary)' },
  express: { file: 'express', color: 'var(--gk-text-primary)' },
  hono: { file: 'hono', color: '#e36002' },
  fastify: { file: 'fastify', color: 'var(--gk-text-primary)' },
  nestjs: { file: 'nestjs', color: '#e0234e' },
  gin: { file: 'gin', multiColor: true },
  echo: { file: 'echo', multiColor: true },
  chi: { file: 'chi', multiColor: true },
  nethttp: { file: 'go', color: '#00add8' },
  fastapi: { file: 'fastapi', color: '#009688' },
  flask: { file: 'flask', color: 'var(--gk-text-primary)' },
  django: { file: 'django', color: '#0c4b33' },
  flutter: { file: 'flutter', color: '#02569b' },
  shelf: { file: 'shelf', color: '#0175c2' },
};

const icon = ICONS[framework];
const iconUrl = icon ? `/assets/framework-icons/${icon.file}.svg` : null;
const iconColor = icon?.color ?? 'currentColor';
const multiColor = icon?.multiColor === true;
---

<a
  class="framework-card"
  href={href}
  data-selected-lang={selectedFor}
  style={iconUrl && !multiColor ? `--icon-url: url('${iconUrl}'); --icon-color: ${iconColor};` : undefined}
>
  {iconUrl && multiColor && <img class="icon icon-img" src={iconUrl} alt="" aria-hidden="true" />}
  {iconUrl && !multiColor && <span class="icon icon-mask" aria-hidden="true"></span>}
  <span class="text">
    <span class="title">{title}</span>
    {description && <span class="description">{description}</span>}
  </span>
  {selectedFor && <span class="selected-indicator">Selected</span>}
</a>

<style>
  .framework-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1.125rem;
    border: 1px solid var(--gk-border-subtle);
    border-radius: var(--gk-radius-md);
    background: var(--gk-surface-1);
    box-shadow: var(--gk-shadow-sm);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Shown only when the card's selectedFor matches the active language (see head.astro). */
  .selected-indicator {
    display: none;
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    align-items: center;
    padding: 0.15rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-genkit-primary);
    background: var(--gk-accent-subtle);
    border: 1px solid var(--gk-accent-border);
    border-radius: 999px;
  }

  .framework-card:hover {
    border-color: var(--gk-border-default);
    background: var(--gk-surface-2);
    transform: translateY(-2px);
  }

  .icon {
    display: block;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }

  .icon-mask {
    background-color: var(--icon-color);
    -webkit-mask-image: var(--icon-url);
    mask-image: var(--icon-url);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  .icon-img {
    object-fit: contain;
    object-position: center;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .title {
    color: var(--gk-text-primary);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--sl-text-base);
    line-height: var(--sl-line-height-headings);
  }

  .description {
    color: var(--gk-text-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
</style>
