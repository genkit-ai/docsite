---
// Simple language-aware ToC that filters based on visible content
const { toc, editUrl } = Astro.locals.starlightRoute;
---

{
	toc && (
		<starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="starlight__on-this-page">
				<h2 id="starlight__on-this-page">{Astro.locals.t('tableOfContents.onThisPage')}</h2>

				<!-- Inline ToC list with same styling as Starlight -->
				<ul class="list-none p-0">
					{toc.items.map((heading) => (
						<li class="transition-opacity duration-200 ease-out">
							<a
								href={'#' + heading.slug}
								class="block truncate rounded-sm px-2 py-1 leading-tight aria-current:text-(--sl-color-text-accent)"
							>
								<span>{heading.text}</span>
							</a>
							{heading.children.length > 0 && (
								<ul class="ml-4 list-none p-0">
									{heading.children.map((child) => (
										<li class="transition-opacity duration-200 ease-out">
											<a
												href={'#' + child.slug}
												class="block truncate rounded-sm px-2 py-1 leading-tight aria-current:text-(--sl-color-text-accent)"
											>
												<span>{child.text}</span>
											</a>
										</li>
									))}
								</ul>
							)}
						</li>
					))}
				</ul>
				{editUrl && (
					<div class="mt-6 border-t border-(--sl-color-hairline) pt-4">
						<a
							href={editUrl.href}
							target="_blank"
							rel="noreferrer noopener"
							class="flex items-center gap-2 text-(length:--sl-text-xs) text-(--sl-color-gray-3) no-underline hover:text-(--sl-color-white)"
						>
							<span class="min-w-0 truncate">Edit this page on GitHub</span>
							<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-[1em] shrink-0"><path d="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
						</a>
					</div>
				)}
			</nav>
		</starlight-toc>
	)
}

<script>
/**
 * Simple Language-aware ToC Filter
 * Hides ToC entries when their corresponding headings are hidden by language CSS
 */
class LanguageAwareToC {
	constructor() {
		// Initialize when DOM is ready
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', () => this.init());
		} else {
			this.init();
		}
	}

	init() {
		const tocContainer = document.querySelector('starlight-toc nav');
		if (!tocContainer) return;

		// Filter ToC immediately and on language changes
		this.filterToC();
		this.setupLanguageObserver();
	}

	filterToC() {
		// Get all currently visible headings
		const visibleHeadingIds = new Set();
		document.querySelectorAll('h1, h2, h3, h4, h5, h6').forEach(heading => {
			if (this.isHeadingVisible(heading) && heading.id) {
				visibleHeadingIds.add(heading.id);
			}
		});

		// Show/hide ToC links based on heading visibility
		document.querySelectorAll('starlight-toc a[href^="#"]').forEach(link => {
			const headingId = link.getAttribute('href')?.slice(1);
			const tocItem = link.closest('li');
			
			if (tocItem && headingId) {
				tocItem.style.display = visibleHeadingIds.has(headingId) ? '' : 'none';
			}
		});
	}

	isHeadingVisible(heading: Element): boolean {
		const style = window.getComputedStyle(heading);
		if (style.display === 'none' || style.visibility === 'hidden') {
			return false;
		}

		// Check if heading is in a hidden language content block
		const langContent = heading.closest('.lang-content');
		if (langContent) {
			const langStyle = window.getComputedStyle(langContent);
			return langStyle.display !== 'none' && langStyle.visibility !== 'hidden';
		}

		return true;
	}

	setupLanguageObserver() {
		// Watch for language changes and update ToC
		const observer = new MutationObserver(() => {
			setTimeout(() => this.filterToC(), 10);
		});

		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-genkit-lang']
		});
	}
}

new LanguageAwareToC();

/**
 * Starlight only marks a ToC entry as current once its heading reaches the top
 * of the viewport. Headings near the end of a page (e.g. "Get started") can
 * never scroll that far, so clicking them left an earlier entry highlighted.
 * This keeps the highlight in sync by:
 *  - honoring the entry that was clicked (or linked via the URL hash) while
 *    its heading is on screen, and
 *  - highlighting the last on-screen heading once the page is scrolled to the
 *    bottom.
 */
type TocElement = HTMLElement & { current?: HTMLAnchorElement };

class TocEndOfPageHighlighter {
	/** Entry the user navigated to; wins while its heading is visible. */
	private pinnedHash: string | null = null;
	private settleTimer: number | undefined;

	constructor() {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', () => this.init());
		} else {
			this.init();
		}
	}

	private get tocs(): TocElement[] {
		return [...document.querySelectorAll<TocElement>('starlight-toc, mobile-starlight-toc')];
	}

	private init() {
		if (this.tocs.length === 0) return;

		document.addEventListener('click', (event) => {
			const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
				'starlight-toc a[href^="#"], mobile-starlight-toc a[href^="#"]'
			);
			if (!link) return;
			this.pinnedHash = link.hash;
			this.setCurrent(link.hash);
			this.scheduleSync();
		});

		window.addEventListener('hashchange', () => {
			this.pinnedHash = location.hash || null;
			this.scheduleSync();
		});

		window.addEventListener('scroll', () => this.scheduleSync(), { passive: true });

		// Once the reader scrolls manually, let normal scroll tracking take over.
		const unpin = () => (this.pinnedHash = null);
		window.addEventListener('wheel', unpin, { passive: true });
		window.addEventListener('touchmove', unpin, { passive: true });
		window.addEventListener('keydown', (event) => {
			if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)) {
				unpin();
			}
		});

		// Deep links such as `/blog/post/#get-started`. Wait for Starlight's own
		// (idle-time) ToC initialisation so our result isn't overwritten.
		if (location.hash) {
			this.pinnedHash = location.hash;
			setTimeout(() => this.sync(), 300);
		}
	}

	/** Run after scrolling settles so we override Starlight's observer, not race it. */
	private scheduleSync() {
		window.clearTimeout(this.settleTimer);
		this.settleTimer = window.setTimeout(() => this.sync(), 120);
	}

	private sync() {
		const viewportBottom = window.innerHeight;
		const headerHeight = document.querySelector('header')?.getBoundingClientRect().height ?? 0;
		const isOnScreen = (el: Element) => {
			const rect = el.getBoundingClientRect();
			return rect.bottom > headerHeight && rect.top < viewportBottom;
		};

		// 1. A clicked/linked entry stays current while its heading is visible.
		if (this.pinnedHash) {
			const heading = this.headingFor(this.pinnedHash);
			if (heading && isOnScreen(heading)) {
				this.setCurrent(this.pinnedHash);
				return;
			}
			this.pinnedHash = null;
		}

		// 2. At the bottom of the page, the last heading on screen is current.
		const scrolledToBottom =
			window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
		if (!scrolledToBottom) return;

		const hashes = this.visibleHashes();
		for (let i = hashes.length - 1; i >= 0; i--) {
			const heading = this.headingFor(hashes[i]);
			// Hidden headings (e.g. other languages) report a zero rect; skip them.
			if (
				heading &&
				heading.offsetHeight > 0 &&
				heading.getBoundingClientRect().top < viewportBottom
			) {
				this.setCurrent(hashes[i]);
				return;
			}
		}
	}

	/**
	 * ToC hashes in document order, skipping entries hidden by the language
	 * filter. Only the desktop `starlight-toc` is filtered by `LanguageAwareToC`,
	 * so prefer it over `mobile-starlight-toc`.
	 */
	private visibleHashes(): string[] {
		const toc =
			this.tocs.find((t) => t.tagName.toLowerCase() === 'starlight-toc') ?? this.tocs[0];
		if (!toc) return [];
		return [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
			.filter((a) => a.closest('li')?.style.display !== 'none')
			.map((a) => a.hash);
	}

	private headingFor(hash: string): HTMLElement | null {
		const id = decodeURIComponent(hash.slice(1));
		return id ? document.getElementById(id) : null;
	}

	/** Use Starlight's own `current` setter so its internal state stays in sync. */
	private setCurrent(hash: string) {
		for (const toc of this.tocs) {
			const link = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].find(
				(a) => a.hash === hash
			);
			if (link) toc.current = link;
		}
	}
}

new TocEndOfPageHighlighter();
</script>